# Telegram — a brand-new, dedicated bot token for this standalone service
# (NOT the same token as Tracker-alert's bot; this is a fully independent bot).
BOT_TOKEN=
# Telegram user id allowed to run the /debugpickup* commands.
ADMIN_USER_ID=

# SQLite path — this repo's own database, not shared with Tracker-alert.
DB_PATH=/app/data/stock_alerts.db

# The scraping provider checkers/common.py's fetch_page uses for plain
# (non-pickup) page fetches, e.g. extracting a SKU from a product page.
# "zyte" (default) or "scrapedo".
SCRAPING_PROVIDER=zyte
# Required if SCRAPING_PROVIDER=zyte — see zyte_client.py.
ZYTE_API_KEY=
# Required if SCRAPING_PROVIDER=scrapedo — see checkers/common.py.
SCRAPEDO_KEY=

# --- Apple official-store pickup auto-check ---
APPLE_PICKUP_PINCODES=110017,400051,400066,560092,411001,201301
APPLE_OFFICIAL_PICKUP_ALERTS_ENABLED=true
APPLE_PICKUP_CHECK_INTERVAL=180

# --- Staggered pickup checking (/trackpickup + channel-forward rows) ---
# Delay between one product's check and the next product's. Each product's
# effective refresh interval ~= this value x (number of tracked product
# rows) — e.g. 5 products at 60s = each refreshes every ~5 minutes.
APPLE_PICKUP_STAGGER_INTERVAL_SECONDS=60
# How many of ONE product's pincodes are checked simultaneously during its
# turn. Keep in step with playwright_scraper's MAX_CONCURRENT_CHECKS.
APPLE_PICKUP_PINCODE_CONCURRENCY=2
# System-wide cap on in-flight Playwright-fallback checks (checkers/apple.py's
# _playwright_fallback_slots). Keep in step with MAX_CONCURRENT_CHECKS too.
APPLE_PLAYWRIGHT_FALLBACK_CONCURRENCY=2

# --- playwright_scraper service (deploy playwright_scraper/ as its own
# Railway service, then point this at its public URL) ---
PLAYWRIGHT_SCRAPER_URL=
PLAYWRIGHT_SCRAPER_INTERNAL_TOKEN=

# --- Apple cookie auto-refresher ---
APPLE_COOKIE_REFRESH_INTERVAL=4500
APPLE_COOKIE_REFRESH_PRODUCT_URL=https://www.apple.com/in/shop/buy-iphone/iphone-17
APPLE_COOKIE_REFRESH_PINCODE=400051
APPLE_COOKIE_REFRESH_MAX_ATTEMPTS=3
APPLE_COOKIE_REFRESH_RETRY_DELAY_MIN_SECONDS=5
APPLE_COOKIE_REFRESH_RETRY_DELAY_MAX_SECONDS=12

# Manual fallback session (used by checkers/apple.py if no DB-stored session
# exists yet from the cookie auto-refresher above).
APPLE_COOKIES=
APPLE_USER_AGENT=
